//@version=5
// PANKAJ LINES - marks the lines Pankaj Sahu marks, on ANY chart (index, stock, option, crude, BTC) and any timeframe.
//  - yesterday's Open / High / Low / Close          (blue)
//  - today's Open, High, Low, 50% of the first 5 minutes (gold / purple)
//  - reversal points = swing highs/lows of the 5-minute and 15-minute charts (grey)   [timeframes are inputs]
//  - round numbers (optional, light)
//  - FEW LINES mode (default): only the day-levels are drawn, swings/round numbers only where they confirm one of them (tested 16 Nov 2026)
//  - STRONG ZONE (gold band) where 3 or more different kinds of line sit together
//  - alert: price touched a strong zone from above and a candle CLOSED back above it  (his "reversal candle close" entry)
// Not his software, not a trading signal, not proven. It only draws the lines so you do not have to.
indicator("Pankaj Lines - any chart", overlay = true, max_lines_count = 300, max_labels_count = 150, max_boxes_count = 60)

grpA = "Reversal points (swings)"
tfA  = input.timeframe("5",  "Swing chart 1", group = grpA)
wA   = input.int(2, "Candles each side (chart 1)", minval = 1, group = grpA)
tfB  = input.timeframe("15", "Swing chart 2", group = grpA)
wB   = input.int(1, "Candles each side (chart 2)", minval = 1, group = grpA)
maxSw = input.int(12, "Swing lines kept per chart", minval = 2, maxval = 40, group = grpA)

grpZ = "Zones"
usePct = input.bool(false, "Zone width in % of price (tick for stocks/index; leave off for options)", group = grpZ)
widthV = input.float(7.0, "Zone width (points, or % if ticked)", minval = 0.01, group = grpZ)
minStr = input.int(3, "Strong zone = this many kinds of line together", minval = 2, maxval = 6, group = grpZ)
showRound = input.bool(true, "Round numbers (never drawn on option charts - not useful there)", group = grpZ)
roundStep = input.float(50.0, "Round number step", minval = 0.01, group = grpZ)
nearV = input.float(5.0, "Touch distance for the alert (points, or % if ticked)", minval = 0.01, group = grpZ)

grpS = "Show"
showPrev = input.bool(true, "Yesterday O/H/L/C", group = grpS)
showToday = input.bool(true, "Today open / high / low / 50% of first 5 min", group = grpS)
showSwing = input.bool(true, "Reversal points", group = grpS)
showLbl = input.bool(true, "Labels", group = grpS)
fewLines = input.bool(true, "Few lines: yesterday O/H/L/C + today open/high/low/50% of first 5 min + every STRONG zone; other swings and round numbers only where they confirm a day-level", group = grpS)
lblV = input.float(12.0, "Merge labels of lines closer than (points, or % if ticked)", minval = 0.0, group = grpS)

colPrev = color.new(#1f5fbf, 0)
colDay  = color.new(#b8860b, 0)
colMid  = color.new(#7a3fa0, 0)
colSw   = color.new(#8a8a8a, 20)
colRnd  = color.new(#bbbbbb, 60)

w(p) => usePct ? p * widthV / 100.0 : widthV
nr(p) => usePct ? p * nearV / 100.0 : nearV

// ---------------------------------------------------------------- yesterday + today, built from 1-minute candles
// An option's 09:15 candle is only the opening auction (not real trading). The default below leaves it out so that the
// open / high / low / 50%-of-first-5-minutes match the numbers the 1-minute candles of the Telegram tool use.
// Switch it off for index, stocks, crypto etc.
skipAuc = input.bool(true, "Leave out the 09:15 opening-auction candle (tick for OPTIONS, untick for index/stocks)", group = grpS)

dayVals(skip) =>
    var float cO = na
    var float cH = na
    var float cL = na
    var float cC = na
    var float eH = na
    var float eL = na
    var float qO = na
    var float qH = na
    var float qL = na
    var float qC = na
    if timeframe.change("D")
        qO := cO
        qH := cH
        qL := cL
        qC := cC
        cO := na
        cH := na
        cL := na
        cC := na
        eH := na
        eL := na
    mins = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
    skipBar = skip and mins == 555
    if not skipBar
        cO := na(cO) ? open : cO
        cH := na(cH) ? high : math.max(cH, high)
        cL := na(cL) ? low : math.min(cL, low)
        cC := close
        if mins >= 555 and mins < 560
            eH := na(eH) ? high : math.max(eH, high)
            eL := na(eL) ? low : math.min(eL, low)
    [qO, qH, qL, qC, cO, cH, cL, eH, eL]

[pO, pH, pL, pC, tO, tH, tL, f5H, f5L] = request.security(syminfo.tickerid, "1", dayVals(skipAuc), lookahead = barmerge.lookahead_off)
f5M = (f5H + f5L) / 2.0

// ---------------------------------------------------------------- reversal points from other timeframes
[phA, plA] = request.security(syminfo.tickerid, tfA, [ta.pivothigh(high, wA, wA), ta.pivotlow(low, wA, wA)], lookahead = barmerge.lookahead_off)
[phB, plB] = request.security(syminfo.tickerid, tfB, [ta.pivothigh(high, wB, wB), ta.pivotlow(low, wB, wB)], lookahead = barmerge.lookahead_off)

var array<float> swA = array.new_float()
var array<float> swB = array.new_float()
addSw(arr, v) =>
    if not na(v)
        dup = false
        if array.size(arr) > 0
            for i = 0 to array.size(arr) - 1
                if math.abs(array.get(arr, i) - v) < syminfo.mintick
                    dup := true
        if not dup
            array.push(arr, v)
            if array.size(arr) > maxSw
                array.shift(arr)
if barstate.isconfirmed or barstate.islast
    addSw(swA, phA)
    addSw(swA, plA)
    addSw(swB, phB)
    addSw(swB, plB)

// ---------------------------------------------------------------- collect every line with its KIND (1 prev, 2 today, 3 swing 5, 4 swing 15, 5 round, 6 mid-of-first-5)
var array<float> zP = array.new_float()
var array<int>   zK = array.new_int()
var array<string> zT = array.new_string()
var array<color>  zC = array.new_color()
var array<string> zSt = array.new_string()
var array<int>    zW = array.new_int()
var array<line>  drawn = array.new_line()
var array<label> lbls = array.new_label()
var array<box>   boxes = array.new_box()

add(p, k, c, txt, st, wd) =>
    if not na(p)
        array.push(zP, p)
        array.push(zK, k)
        array.push(zT, txt)
        array.push(zC, c)
        array.push(zSt, st)
        array.push(zW, wd)

if barstate.islast
    for l in drawn
        line.delete(l)
    array.clear(drawn)
    for lb in lbls
        label.delete(lb)
    array.clear(lbls)
    for b in boxes
        box.delete(b)
    array.clear(boxes)
    array.clear(zP)
    array.clear(zK)
    array.clear(zT)
    array.clear(zC)
    array.clear(zSt)
    array.clear(zW)

    if showPrev
        add(pO, 1, colPrev, "yest.open", line.style_dashed, 1)
        add(pH, 1, colPrev, "yest.HIGH", line.style_solid, 2)
        add(pL, 1, colPrev, "yest.LOW", line.style_solid, 2)
        add(pC, 1, colPrev, "yest.close", line.style_solid, 2)
    if showToday
        add(tO, 2, colDay, "today open", line.style_solid, 1)
        add(tH, 2, colDay, "today high", line.style_dashed, 1)
        add(tL, 2, colDay, "today low", line.style_dashed, 1)
        add(f5M, 6, colMid, "50% 1st 5m", line.style_dashed, 1)
    if showSwing
        if array.size(swA) > 0
            for i = 0 to array.size(swA) - 1
                add(array.get(swA, i), 3, colSw, "5m swing", line.style_dotted, 1)
        if array.size(swB) > 0
            for i = 0 to array.size(swB) - 1
                add(array.get(swB, i), 4, colSw, "15m swing", line.style_dashed, 1)
    if showRound and syminfo.type != "option"
        base = math.floor((close - 6 * roundStep) / roundStep) * roundStep
        for i = 0 to 12
            k = base + i * roundStep
            if k > 0
                array.push(zP, k)
                array.push(zK, 5)
                array.push(zT, "round")
                array.push(zC, color.new(#999999, 0))
                array.push(zSt, line.style_dotted)
                array.push(zW, 1)

    // ---- FEW LINES (his charts carry about 8, not 40+): keep the day-levels (yesterday O/H/L/C, today open/high/low, 50% of first 5 min);
    // a swing or round number stays only if it lies within the zone width of one of those (it then confirms it, it is never drawn alone)
    // strong zones (3+ kinds of line together) are NEVER removed: every line that belongs to one stays drawn
    inStrong = array.new_bool(array.size(zP), false)
    if array.size(zP) > 0
        idS = array.sort_indices(zP, order.ascending)
        gS0 = 0
        nS = array.size(zP)
        for j3 = 0 to nS - 1
            curS = array.get(zP, array.get(idS, j3))
            egS = j3 == nS - 1
            if not egS
                egS := array.get(zP, array.get(idS, j3 + 1)) - curS > w(curS)
            if egS
                ksS = array.new_int()
                for q3 = gS0 to j3
                    kdS = array.get(zK, array.get(idS, q3))
                    if not array.includes(ksS, kdS)
                        array.push(ksS, kdS)
                if array.size(ksS) >= minStr
                    for q3 = gS0 to j3
                        array.set(inStrong, array.get(idS, q3), true)
                gS0 := j3 + 1
    if fewLines and array.size(zP) > 0
        for i = array.size(zP) - 1 to 0
            ki = array.get(zK, i)
            keepI = ki == 1 or ki == 2 or ki == 6 or array.get(inStrong, i)
            if not keepI
                for j2 = 0 to array.size(zP) - 1
                    kj = array.get(zK, j2)
                    if (kj == 1 or kj == 2 or kj == 6) and math.abs(array.get(zP, j2) - array.get(zP, i)) <= w(array.get(zP, i))
                        keepI := true
            if not keepI
                array.remove(zP, i)
                array.remove(zK, i)
                array.remove(zT, i)
                array.remove(zC, i)
                array.remove(zSt, i)
                array.remove(zW, i)
                array.remove(inStrong, i)
    if array.size(zP) > 0
        for i = 0 to array.size(zP) - 1
            array.push(drawn, line.new(bar_index - 1, array.get(zP, i), bar_index, array.get(zP, i), extend = extend.both, color = array.get(zC, i), style = array.get(zSt, i), width = array.get(zW, i)))

    // ---- strong zones: group lines within the zone width, count different KINDS
    n = array.size(zP)
    if n > 0
        idx = array.sort_indices(zP, order.ascending)
        gStart = 0
        for j = 0 to n - 1
            cur = array.get(zP, array.get(idx, j))
            endGroup = j == n - 1
            if not endGroup
                nxt = array.get(zP, array.get(idx, j + 1))
                endGroup := nxt - cur > w(cur)
            if endGroup
                kinds = array.new_int()
                lo = array.get(zP, array.get(idx, gStart))
                hi = cur
                for q = gStart to j
                    kd = array.get(zK, array.get(idx, q))
                    if not array.includes(kinds, kd)
                        array.push(kinds, kd)
                if array.size(kinds) >= minStr
                    array.push(boxes, box.new(bar_index - 60, hi + w(hi) * 0.15, bar_index + 30, lo - w(lo) * 0.15, bgcolor = color.new(#f4b400, 78), border_color = color.new(#f4b400, 40), extend = extend.none))
                    array.push(lbls, label.new(bar_index - 58, (lo + hi) / 2, "STRONG " + str.tostring((lo + hi) / 2, format.mintick), style = label.style_none, textcolor = color.new(#8a6400, 0), size = size.small))
                gStart := j + 1

    // ---- ONE readable label per cluster of nearby lines (names joined, one price); every line is still drawn
    if showLbl and n > 0
        idl = array.sort_indices(zP, order.ascending)
        gl = 0
        for j = 0 to n - 1
            curL = array.get(zP, array.get(idl, j))
            egl = j == n - 1
            if not egl
                nxL = array.get(zP, array.get(idl, j + 1))
                egl := nxL - curL > (usePct ? curL * lblV / 100.0 : lblV)
            if egl
                nmList = array.new_string()
                loL = array.get(zP, array.get(idl, gl))
                colL = array.get(zC, array.get(idl, gl))
                bestL = 99
                for q = gl to j
                    ii = array.get(idl, q)
                    tn = array.get(zT, ii)
                    if not array.includes(nmList, tn)
                        array.push(nmList, tn)
                    kk = array.get(zK, ii)
                    prL = kk == 1 ? 0 : kk == 2 ? 1 : kk == 6 ? 2 : kk == 3 ? 3 : kk == 4 ? 4 : 5
                    if prL < bestL
                        bestL := prL
                        colL := array.get(zC, ii)
                cntL = array.size(nmList)
                shownL = math.min(cntL, 4)
                txL = ""
                for z = 0 to shownL - 1
                    txL := txL + (z > 0 ? " + " : "") + array.get(nmList, z)
                if cntL > shownL
                    txL := txL + " +" + str.tostring(cntL - shownL)
                midL = (loL + curL) / 2.0
                array.push(lbls, label.new(bar_index + 2, midL, str.tostring(midL, format.mintick) + "  " + txL, style = label.style_none, textcolor = colL, size = size.small))
                gl := j + 1

// ---------------------------------------------------------------- alert: touched a strong zone from above and a candle CLOSED back above it
// (uses the last drawn zones; the alert fires on the bar close)
var array<float> strongP = array.new_float()
if barstate.islast
    array.clear(strongP)
    if array.size(zP) > 0
        idx2 = array.sort_indices(zP, order.ascending)
        gs = 0
        nn = array.size(zP)
        for j = 0 to nn - 1
            cur = array.get(zP, array.get(idx2, j))
            eg = j == nn - 1
            if not eg
                eg := array.get(zP, array.get(idx2, j + 1)) - cur > w(cur)
            if eg
                ks = array.new_int()
                for q = gs to j
                    kd = array.get(zK, array.get(idx2, q))
                    if not array.includes(ks, kd)
                        array.push(ks, kd)
                if array.size(ks) >= minStr
                    array.push(strongP, (array.get(zP, array.get(idx2, gs)) + cur) / 2)
                gs := j + 1

touched = false
hit = false
if array.size(strongP) > 0
    for z in strongP
        if ta.lowest(low, 4) <= z + nr(z) and close > z and close > open and close[1] <= z + nr(z) and low < z + nr(z)
            hit := true
plotshape(hit and barstate.isconfirmed, "Closed back above a strong zone", shape.triangleup, location.belowbar, color.new(#2a9d5c, 0), size = size.small, text = "BUY?")
alertcondition(hit, "Closed back above a strong zone", "Pankaj Lines: a candle closed back above a strong zone on {{ticker}} - check the chart")
